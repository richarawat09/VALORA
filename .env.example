# VALORA Healthcare Management & Digital Medical Records Platform
# Environment Configuration

# MongoDB Atlas or Local Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/valora

# Authentication Secret (Used for JWT / Session encryption - minimum 32 characters)
AUTH_SECRET=valora_healthcare_super_secret_jwt_key_2026_secure_medical_platform
JWT_SECRET=valora_healthcare_super_secret_jwt_key_2026_secure_medical_platform

# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloud Storage (Cloudinary - Optional fallback operates smoothly when omitted)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

